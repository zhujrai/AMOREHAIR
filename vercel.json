{
  "buildCommand": "vite build && node scripts/generar-vistas-previas.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/pedidos", "destination": "/pedidos.html" },
    { "source": "/catalogo", "destination": "/catalogo.html" },
    { "source": "/catalogo/(.*)", "destination": "/catalogo.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
