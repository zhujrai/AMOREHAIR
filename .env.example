# Plantilla de variables de entorno. Copia este archivo a .env (o .env.local) y rellena los valores.
# NUNCA subas valores reales al repositorio. Los reales viven en el gestor de secretos del arnés
# (Amore-Conocimiento/secretos) y en el panel del hosting (Vercel/Cloudflare).

# --- Frontend (Vite): clave PUBLICABLE / anon de Supabase (segura solo si RLS está activo) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# --- Servidor local (server.ts), solo para desarrollo ---
SUPABASE_URL=
SUPABASE_KEY=
# Cadena de conexión a Postgres: contiene la contraseña de la base de datos. SECRETA.
DATABASE_URL=

# --- Couriers (opcional) ---
SHALOM_API_KEY=
OLVA_API_KEY=
MARVISUR_API_KEY=

# --- Gemini (opcional) ---
GEMINI_API_KEY=

# URL donde se aloja la app
APP_URL=

# Servidor local (opcional): secretos propios. Sin ellos se generan aleatorios.
ADMIN_SESSION_SECRET=
ADMIN_DEFAULT_PASSWORD=
